{
  "expo": {
    "name": "Centopeia",
    "slug": "Centopeia_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.escolacentopeia.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#84CC3A",
          "defaultChannel": "agenda"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Centopeia usa suas fotos para anexar a receita médica do seu filho.",
          "cameraPermission": "O Centopeia usa a câmera para fotografar a receita médica do seu filho.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAF3"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3984e893-7a03-4e8c-a87a-415e3ed67c98"
      }
    }
  }
}
