# URL base da API Laravel (EscolaCentopeia), incluindo o sufixo /api.
# Padrão local: homologação. Produção = dados reais; veja AMBIENTES.md.
# Builds EAS definem esta variável por perfil em eas.json.
# Homologação:
EXPO_PUBLIC_API_URL=https://homolog.escolacentopeia.com.br/api
# Produção:
# EXPO_PUBLIC_API_URL=https://app.escolacentopeia.com.br/api
